# Copy to .env.local and fill in. Set the same values on the blog's Vercel project.

# MongoDB Atlas connection string, including the database name.
# The Prisma CLI reads this from .env, so put DATABASE_URL there as well.
DATABASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder in Cloudinary that uploads go into (defaults to raselrana-blog)
CLOUDINARY_UPLOAD_FOLDER=raselrana-blog

# Auth.js - generate the secret with: npx auth secret
AUTH_SECRET=
# Local: http://localhost:3000/api/auth
AUTH_URL=

# Must match basePath in next.config.mjs
NEXT_PUBLIC_BASE_PATH=/blog

# Only read by src/scripts/create-admin.js (password: at least 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
